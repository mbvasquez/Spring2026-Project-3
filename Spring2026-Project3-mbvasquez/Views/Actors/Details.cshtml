@model Spring2026_Project3_mbvasquez.Models.Actor
@using static Spring2026_Project3_mbvasquez.Models.AIGen
@using VaderSharp2

@{
    ViewData["Title"] = "Details";
    string? actor = Model.Name ?? "";
}

<h1>Details</h1>

<div>
    <h4>Actor</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Name)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Name)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Gender)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Gender)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Age)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Age)
        </dd>
        <dt class="col-sm-2">
            @* @Html.DisplayNameFor(model => model.ImbdLink) *@
            IMDb Link
        </dt>
        <dd class="col-sm-10">
            <a href="@Html.DisplayFor(modelItem => modelItem.ImbdLink)" target="_blank">@Html.DisplayFor(modelItem => modelItem.ImbdLink)</a>
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Photo)
        </dt>
        <dd class="col-sm-10">
            @if (Model.Photo != null)
            {
                <img src="@Url.Action("Photo", "Actors", new { Model.Id })" width="200" />
            }
        </dd>
    </dl>
    <div>
        <h4>Movies with @actor</h4>
        @{
            MovieNames movies = await MoviesWithActor(actor);
            string? list = null;
            foreach (MovieName movie in movies.Items)
            {
                list += $"<li>{movie.Movie}</li>";
            }
            <ul>
                @Html.Raw(list)
            </ul>
        }
        <h4>AI Twitter Reviews</h4>
        @{
            Tweets tweets = await TwitterApiSimJson(actor);
            var analyzer = new SentimentIntensityAnalyzer();
            double sentimentTotal = 0;
            string? output = null;
            foreach (Tweet tweet in tweets.Items)
            {
                SentimentAnalysisResults sentiment = analyzer.PolarityScores(tweet.Text);
                sentimentTotal += sentiment.Compound;
                output += $"<tr><td><b>{tweet.Username}:</b> \"{tweet.Text}\"</td><td>{sentiment.Compound}</td></tr>";
            }
            double sentimentAverage = sentimentTotal / tweets.Items.Length;
            string sentimentOutput = $"##### Sentiment Average: {sentimentAverage:#.###} #####";
            <p>@Html.Raw(sentimentOutput)</p>
            <table class="table">
                <tr>
                    <th>Tweets</th>
                    <th>Sentiment</th>
                </tr>
                @Html.Raw(output)
            </table>
        }
    </div>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
