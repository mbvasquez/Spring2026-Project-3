@model IEnumerable<Spring2026_Project3_mbvasquez.Models.Movie>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Title)
            </th>
            <th>
                @* @Html.DisplayNameFor(model => model.ImbdLink) *@
                IMDb Link
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Genre)
            </th>
            <th>
                @* @Html.DisplayNameFor(model => model.YearOfRelease) *@
                Year of Release
            </th>
            @* <th>
                @Html.DisplayNameFor(model => model.Poster)
            </th> *@
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Title)
            </td>
            <td>
                <a href="@Html.DisplayFor(modelItem => item.ImbdLink)" target="_blank">@Html.DisplayFor(modelItem => item.ImbdLink)</a>
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Genre)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.YearOfRelease)
            </td>
            @* <td>
                @Html.DisplayFor(modelItem => item.Poster)
            </td> *@
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
