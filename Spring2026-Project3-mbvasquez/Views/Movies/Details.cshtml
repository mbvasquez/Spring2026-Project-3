@model Spring2026_Project3_mbvasquez.Models.Movie
@using static Spring2026_Project3_mbvasquez.Models.AIGen
@using VaderSharp2

@{
    ViewData["Title"] = "Details";
    string movie = Model.Title ?? "";
    int year = Model.YearOfRelease;
}

<h1>Details</h1>

<div>
    <h4>Movie</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Title)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Title)
        </dd>
        <dt class = "col-sm-2">
            @* @Html.DisplayNameFor(model => model.ImbdLink) *@
            IMDb Link
        </dt>
        <dd class = "col-sm-10">
            <a href="@Html.DisplayFor(modelItem => modelItem.ImbdLink)" target="_blank">@Html.DisplayFor(modelItem => modelItem.ImbdLink)</a>
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Genre)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Genre)
        </dd>
        <dt class = "col-sm-2">
            @* @Html.DisplayNameFor(model => model.YearOfRelease) *@
            Year of Release
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.YearOfRelease)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Poster)
        </dt>
        <dd class = "col-sm-10">
            @if (Model.Poster != null)
            {
                <img src="@Url.Action("Poster", "Movies", new { Model.Id })" width="200" />
            }
            else {
                @Html.Raw("Poster failed to load");
            }
        </dd>
    </dl>
    <div>
        <h4>Actors in @movie</h4>
        @{
            ActorNames actors = await ActorsInMovie(movie, year);
            string? list = null;
            foreach (ActorName actor in actors.Items)
            {
                list += $"<li>{actor.Actor}</li>";
            }
            <ul>
                @Html.Raw(list)
            </ul>
        }
        <h4>AI Movie Reviews</h4>
        @{
            Reviews reviews = await MovieReviews(movie, year);
            var analyzer = new SentimentIntensityAnalyzer();
            double sentimentTotal = 0;
            string? output = null;
            foreach (Review review in reviews.Items)
            {
                SentimentAnalysisResults sentiment = analyzer.PolarityScores(review.Text);
                sentimentTotal += sentiment.Compound;
                output += $"<tr><td>{review.Text}</td><td>{sentiment.Compound}</td></tr>";
            }
            double sentimentAverage = sentimentTotal / reviews.Items.Length;
            string sentimentOutput = $"##### Sentiment Average: {sentimentAverage:#.###} #####";
            <p>@Html.Raw(sentimentOutput)</p>
            <table class="table">
                <tr>
                    <th>Reviews</th>
                    <th>Sentiment</th>
                </tr>
                @Html.Raw(output)
            </table>
        }
    </div>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
